<div class="page-content">

    <div class="row windowContent">
        <div class="col-xs-12">
            <div id="home">
                @using (Html.BeginForm("MyListDetail", "DahiliYazisma", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    <div style="overflow-x:hidden;overflow-y:auto;height:650px;">
                        @Html.HiddenFor(m => m.Id)

                        <div class="space-10"></div>

                        <div>
                            <img src="~/Img/@Model.Company.imgUrl" style="width:100px;height:50px;" />
                        </div>
                        <div style="height:40px;">
                            <div style="float: right; color: brown;text-transform:uppercase;">
                                @ViewBag.CompanyTitle
                                <br />
                                @ViewBag.CompanyLongName
                            </div>
                        </div>
                        <hr style="margin:0px;border:2px solid black;">
                        <div class="form-group">
                            <label class="col-sm-3">Servisi:</label>
                            <div class="col-sm-9 vcenter-form ">
                                <strong>@Model.Servisi</strong>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3">Konu:</label>
                            <div class="col-sm-9 vcenter-form ">
                                <strong>@Model.Konu</strong>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3">Tarih:</label>
                            <div class="col-sm-9 vcenter-form ">
                                <strong>@Model.Tarih.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3">Sayı:</label>
                            <div class="col-sm-9 vcenter-form ">
                                <strong>@Model.Id</strong>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3">Kanal:</label>
                            <div class="col-sm-9 vcenter-form ">
                                <strong>@Model.Kanal</strong>
                            </div>
                        </div>
                        <div class="form-group">

                            <div class="col-sm-9 vcenter-form ">
                                @Html.Raw(Model.Icerik)
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right">Eklenen Dosyalar:</label>
                            <div class="col-sm-9 vcenter-form ">
                                @{
                                    BLLActions.AttachedFiles bllAttachedFiles = new BLLActions.AttachedFiles();
                                    List<AttachedFile> listAttachedFiles = bllAttachedFiles.Get((int)CommonConstants.MODULES.DAHILIYAZISMA, Model.Id, null);
                                    foreach (var item in listAttachedFiles)
                                    {
                                        <div>
                                            <a href="~/files/documents/@item.filePath" target="_blank">@item.filePath</a>
                                        </div>
                                    }
                                }

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right">Onay Süreci:</label>
                            <div class="col-sm-9 vcenter-form ">

                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right"></label>
                            <div class="col-sm-9 vcenter-form">
                                @{


                                    for (int i = 0; i < 5; i++)
                                    {
                                        var status = 0;
                                        string date = "";
                                        DahiliYazismalarDetayTable isInList = null;

                                        if (i == 0 && Model.DahiliYazismalarDetayTables.Any(q => q.userId == Model.Onaylayici1 && q.status == true && q.sonOnayMi == false))
                                        {
                                            isInList = Model.DahiliYazismalarDetayTables.Where(q => q.userId == Model.Onaylayici1 && q.status == true && q.sonOnayMi == false).FirstOrDefault();
                                        }
                                        else if (i == 1 && Model.DahiliYazismalarDetayTables.Any(q => q.userId == Model.Onaylayici2 && q.status == true && q.sonOnayMi == false))
                                        {
                                            isInList = Model.DahiliYazismalarDetayTables.Where(q => q.userId == Model.Onaylayici2 && q.status == true && q.sonOnayMi == false).FirstOrDefault();
                                        }
                                        else if (i == 2 && Model.DahiliYazismalarDetayTables.Any(q => q.userId == Model.Onaylayici3 && q.status == true && q.sonOnayMi == false))
                                        {
                                            isInList = Model.DahiliYazismalarDetayTables.Where(q => q.userId == Model.Onaylayici3 && q.status == true && q.sonOnayMi == false).FirstOrDefault();
                                        }
                                        else if (i == 3 && Model.DahiliYazismalarDetayTables.Any(q => q.userId == Model.Onaylayici4 && q.status == true && q.sonOnayMi == false))
                                        {
                                            isInList = Model.DahiliYazismalarDetayTables.Where(q => q.userId == Model.Onaylayici4 && q.status == true && q.sonOnayMi == false).FirstOrDefault();
                                        }
                                        else if (i == 4)
                                        {
                                            isInList = Model.DahiliYazismalarDetayTables.Where(q => q.userId == ceoTable.userId && q.status == true).FirstOrDefault();
                                        }

                                        if (isInList != null)
                                        {
                                            if (isInList.approved == null)
                                            {
                                                status = 1; // bekliyor
                                            }
                                            else if (isInList.approved.Value)
                                            {
                                                date = isInList.replyDate.Value.ToString("dd.MM.yyyy HH:mm");
                                                status = 2; // onayladı
                                            }
                                            else
                                            {
                                                date = isInList.replyDate.Value.ToString("dd.MM.yyyy HH:mm");
                                                status = 3; // reddetti
                                            }
                                        }

                                        if (status == 1)
                                        {
                                            <div class="profile-activity clearfix alert alert-info" style="border:1px solid">
                                                <div>
                                                    <img class="pull-left" alt="@isInList.AdminUser.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @isInList.AdminUser.imageUrl, "?width=50&height=50")">
                                                    <a href="javascript:;" class="user tooltip-info">@isInList.AdminUser.name (@isInList.AdminUser.Company.VTEXT)</a>
                                                    <span class="time">
                                                        <i class="ace-icon fa fa-clock-o bigger-110"></i>
                                                        <strong>ONAYI BEKLENİYOR...</strong>
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                        else if (status == 2)
                                        {
                                            <div class="profile-activity clearfix alert alert-success down-arrow">
                                                <div>
                                                    <img class="pull-left" alt="@isInList.AdminUser.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @isInList.AdminUser.imageUrl, "?width=50&height=50")">
                                                    <a href="javascript:;" class="user tooltip-info">@isInList.AdminUser.name (@isInList.AdminUser.Company.VTEXT)</a>
                                                    <span class="time">
                                                        <i class="ace-icon fa fa-clock-o bigger-110"></i>
                                                        <strong>Onaylama Tarihi: @date</strong>
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                        else if (status == 3)
                                        {
                                            <div class="profile-activity clearfix  alert alert-danger">
                                                <div>
                                                    <img class="pull-left" alt="@isInList.AdminUser.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @isInList.AdminUser.imageUrl, "?width=50&height=50")">
                                                    <a href="javascript:;" class="user tooltip-info">@isInList.AdminUser.name (@isInList.AdminUser.Company.VTEXT)</a>
                                                    <span class="time">
                                                        <i class="ace-icon fa fa-clock-o bigger-110"></i>
                                                        <strong>Reddetme Tarihi: @date</strong>
                                                    </span>
                                                    @*<p class="post">Red Açıklaması: @isInList.description </p>*@
                                                </div>
                                            </div>
                                        }
                                        else
                                        {



                                            if (i == 0 && Model.Onaylayici1.HasValue)
                                            {
                                                AdminUser adminUser = bllAdminUsers.GetByID(Model.Onaylayici1.Value);
                                                <div class="profile-activity clearfix  alert alert-warning">
                                                    <div>
                                                        <img class="pull-left" alt="@adminUser.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @adminUser.imageUrl, "?width=50&height=50")">
                                                        <span href="javascript:;" class="user-passive tooltip-info">@adminUser.name (@adminUser.Company.VTEXT)</span>
                                                        <span class="time">
