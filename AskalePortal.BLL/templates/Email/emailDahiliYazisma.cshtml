                                                        </span>
                                                    </div>
                                                </div>
                                            }

                                        }

                                    }


                                }
                            </div>

                        </div>
                    
                    
                    </div>
                    if (ceoTable.userId == ViewBag.userId)
                    {
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9" style="margin-top:20px;width:200px;">
                                @Html.DropDownList("kanalGorusuUserId", "--Göndereceğiniz Kişiyi Seçiniz--")
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9" style="margin-top:20px;width:200px;">
                                @Html.DropDownList("bilgiUserId", "--Bilgi Yapılacak Kişiyi Seçiniz--")
                            </div>
                        </div>
                        <div>
                            <label><b><u>Kanal Görüşünüz:</u></b></label>
                            @Html.TextArea("kanalGorusuCeo", new { @class = "summernote", style = "height:150px;width:80%" })
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label><b><u>Ceo Kanal Görüşü: </u></b></label>
                            <br />
                            @Html.Raw(Model.KanalGorusuCeo)
                        </div>
                    }
                    <div class="form-group">
                        <label class="col-sm-3 control-label no-padding-right"></label>
                        <div class="col-sm-9">

                            <button id="btnOnayla" class="btn btn-success">
                                <i class="icon-remove"></i>
                                ONAYLA
                            </button>

                            <a href="@Url.Action("GetRedEtme",new { @Model.Id })" class="btn btn-danger">
                                <i class="icon-remove"></i>
                                REDDET
                            </a>

                            <a href="javascript:void(0)" class="btn" onclick="parent.jQuery.fancybox.close()">
                                <i class="icon-remove"></i>
                                Kapat
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    $('.summernote').summernote({
        height: 350,
        width: '80%'
    });

    $("#btnOnayla").click(function () {
        var id = $("#Id").val();
        var kanalGorusuCeo = $("#kanalGorusuCeo").val();
        var kanalGorusuUserId = $("#kanalGorusuUserId").val();
        var bilgiUserId = $("#bilgiUserId").val();
        $.ajax({
			type: "POST",
			url: "@Url.Action("Reply", "DahiliYazisma")",

			data: {
				'id': id,
                'kanalGorusuCeo': kanalGorusuCeo,
                'kanalGorusuUserId': kanalGorusuUserId,
                'bilgiUserId': bilgiUserId
			},
			success: function (result) {

                parent.$.fancybox.close();
                parent.location.reload();
                parent.NotyMessage('Cevabınız kaydedildi.', 'success');
			}

        });
    });
</script>

    </div>


</body>
</html>
