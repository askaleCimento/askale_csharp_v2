    <script type="text/javascript">

        function NotyMessage(text, type) {
            var n = noty({
                text: text,
                type: type,
                layout: 'topRight',
                animation: {
                    open: { height: 'toggle' },
                    close: { height: 'toggle' },
                    easing: 'swing',
                    speed: 500 // opening & closing animation speed
                },
                timeout: 5000
            });
        }

        function OpenPopUp(url, width, height) {

            $.fancybox({
                'width': width,
                'height': height,
                'autoScale': false,
                'transitionIn': 'none',
                'transitionOut': 'none',
                'type': 'iframe',
                'href': url
            });
        }





            $("#loading").hide();

            $('.loading-btn').on(ace.click_event, function () {
                $(this).button('loading');
            });

            $('.date-picker').datepicker({ autoclose: true }).next().on(ace.click_event, function () {
                $(this).prev().focus();
            });

            $('.colorpicker').colorpicker();

            $(".delete-confirm").on(ace.click_event, function (e) {

                e.preventDefault();
                var $el = $(this);

                bootbox.confirm("Kayıt Silinecektir. Emin misiniz?", function (result) {
                    if (result) {
                        window.location = $el.attr("href");
                    }
                });
            });


            $("form").find("input.ace[type='checkbox']").change(function () {

                var elementName = $(this).attr("name").substring(1);
                $("input[type='hidden'][name='" + elementName + "']").attr("value", $(this).is(':checked'));

            });

            $('[data-rel="tooltip"]').tooltip();

            $(".chosen-select").chosen();

            //we could just set the data-provide="tag" of the element inside HTML, but IE8 fails!
            var tag_input = $('.form-field-tags');
            if (!(/msie\s*(8|7|6)/.test(navigator.userAgent.toLowerCase()))) {
                tag_input.tag(
                    {
                        placeholder: tag_input.attr('placeholder'),
                        //enable typeahead by specifying the source array
                        source: ace.variable_US_STATES,//defined in ace.js >> ace.enable_search_ahead
                    }
                );
            }
            else {
                //display a textarea for old IE, because it doesn't support this plugin or another one I tried!
                tag_input.after('<textarea id="' + tag_input.attr('id') + '" name="' + tag_input.attr('name') + '" rows="3">' + tag_input.val() + '</textarea>').remove();
                //$('#form-field-tags').autosize({append: "\n"});
            }


            $('table th input:checkbox').on('click', function () {
                var that = this;
                $(this).closest('table').find('tr > td:first-child input:checkbox')
                    .each(function () {
                        this.checked = that.checked;
                        $(this).closest('tr').toggleClass('selected');
                    });

            });



    </script>



    @RenderSection("Scripts", false)

