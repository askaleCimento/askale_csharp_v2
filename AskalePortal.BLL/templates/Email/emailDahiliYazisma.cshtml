                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                            else if (i == 4)
                                            {
                                                AdminUser adminUser2 = bllAdminUsers.GetByID(ceoTable.userId);
                                                <div class="profile-activity clearfix  alert alert-warning">
                                                    <div>
                                                        <img class="pull-left" alt="@adminUser2.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @adminUser2.imageUrl, "?width=50&height=50")">
                                                        <span href="javascript:;" class="user-passive tooltip-info">@adminUser2.name (@adminUser2.Company.VTEXT)</span>
