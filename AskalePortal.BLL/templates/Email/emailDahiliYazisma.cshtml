                                            }
                                            else if (i == 3 && Model.Onaylayici4.HasValue)
                                            {
                                                AdminUser adminUser = bllAdminUsers.GetByID(Model.Onaylayici4.Value);
                                                <div class="profile-activity clearfix  alert alert-warning">
                                                    <div>
                                                        <img class="pull-left" alt="@adminUser.name" src="@string.Concat(CommonConstants.UPLOAD_FILE_ADMIN_USER_IMAGE, @adminUser.imageUrl, "?width=50&height=50")">
                                                        <span href="javascript:;" class="user-passive tooltip-info">@adminUser.name (@adminUser.Company.VTEXT)</span>
                                                        <span class="time">
